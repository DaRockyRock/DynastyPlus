# Copy this file to .env and fill in your values.

# LLM connection -----------------------------------------------------------
# These only SEED the connection on first run. The normal way to connect a model
# is the in-app setup wizard (it opens on first launch and writes data/llm.json,
# which then takes precedence over everything below). Leave these blank to be
# greeted by the wizard.

# Anthropic API key. Leave blank to run the app entirely on mock content
# (great for building out the UI without spending tokens).
ANTHROPIC_API_KEY=

# Model used for all generation. Haiku is the fast, cheap default.
#   claude-haiku-4-5  (fastest, cheapest)
#   claude-sonnet-4-6 (balanced)
#   claude-opus-4-8   (most capable)
CFBMOD_MODEL=claude-haiku-4-5

# Master switch for LLM generation.
#   false -> every module returns rich mock content (no API calls, no cost)
#   true  -> modules call the connected model (needs a key, or a local base URL)
# Default is false so the app runs out of the box for design work.
CFBMOD_USE_LLM=false

# Connect a model running locally instead of Anthropic's hosted API. Works with
# any OpenAI-compatible server (Ollama, LM Studio, llama.cpp, vLLM, ...). Set the
# provider to "local", point at the server's base URL, and set CFBMOD_MODEL to
# the local model name (e.g. llama3.1).
#   CFBMOD_LLM_PROVIDER=local
#   CFBMOD_LLM_BASE_URL=http://localhost:11434/v1
CFBMOD_LLM_PROVIDER=
CFBMOD_LLM_BASE_URL=

# Absolute path to the dynasty save the companion watches. Defaults to
# data/save/dynasty.json, which the Simulator (run_sim.py) writes. Point this at
# the real CFB 27 save once its format is known.
CFBMOD_SAVE_PATH=

# Absolute path to the companion inbox (coach actions queued for the Simulator).
# Defaults to data/save/companion_inbox.json. Rarely needs changing.
CFBMOD_INBOX_PATH=

# Host/ports for the local web servers.
CFBMOD_HOST=127.0.0.1
CFBMOD_PORT=5050       # Dynasty+ companion (run.py)
CFBMOD_SIM_PORT=5070   # Simulator / CFB 27 stand-in (run_sim.py)
