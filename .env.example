# Copy this file to .env to override Dynasty+ Tools defaults.

# Runtime storage. Source checkouts default to ./data.
CFBMOD_DATA_DIR=

# Exported dynasty snapshot. Defaults to data/save/dynasty.json.
CFBMOD_SAVE_PATH=

# Local web server.
CFBMOD_HOST=127.0.0.1
CFBMOD_PORT=5050

# Modeled resource defaults.
CFBMOD_DP_PER_DOLLAR=0.0004
CFBMOD_WEEKLY_HOURS=1500
