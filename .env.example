# Optional local overrides for Dynasty+ Tools.

# CFB 27 saves folder, or one specific dynasty save. Defaults to:
#   ~/Documents/EA SPORTS College Football 27/saves
CFBMOD_SAVE_PATH=

# CFB 27 installation folder used to extract local logos, helmets, and fonts.
# The desktop Setup screen can detect or change this without editing .env.
CFBMOD_GAME_ROOT=

# Local server settings.
CFBMOD_HOST=127.0.0.1
# CFBMOD_PORT=5051

# Optional runtime-data override. Installed builds use the operating system's
# normal per-user application-data folder automatically.
CFBMOD_DATA_DIR=

# Custom playoff autosync is enabled by default. Set false to require manual
# updates from the Playoff Bracket screen.
CFBMOD_PLAYOFF_AUTOSYNC=true
